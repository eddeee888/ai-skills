{
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor-memory-sync.sh\" pull \"${PR_MEMORY_REPO}\"",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor-memory-sync.sh\" push \"${PR_MEMORY_REPO}\"",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/cursor-memory-sync.sh\" end \"${PR_MEMORY_REPO}\"",
        "timeout": 30
      }
    ]
  }
}
